rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Block user enumeration
      allow create: if isOwner(userId) &&
        incoming().id == userId &&
        incoming().email is string;
      allow update: if isOwner(userId) &&
        incoming().id == existing().id;
      allow delete: if false;
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().name is string &&
        incoming().name.size() <= 120 &&
        incoming().templateId is string;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().name is string &&
        incoming().name.size() <= 120;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Download audit logs
    match /downloads/{downloadId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
